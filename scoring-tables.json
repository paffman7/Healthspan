              "slope": 1.5
            }
          },
          "female": {
            "weightSplitKg": 61.36,
            "atOrBelowSplit": {
              "intercept": 14.6,
              "slope": 1.5
            },
            "aboveSplit": {
              "intercept": 14.9,
              "slope": 1.5
            }
          }
        },
        "notHighlyTrained": {
          "male": {
            "intercept": 10.7,
            "slope": 0.9
          },
          "female": {
            "intercept": 10.26,
            "slope": 0.93
          }
        },
        "resultDecimals": 2,
        "validMinVo2": 10,
        "note": "Used for the 2K row functional age when config.rowVo2Method is 'concept2'. The tier still comes from the row_2k time table. Results below validMinVo2 are outside the formula's data range and are flagged."
      },
      "rockportFormula": {
        "expression": "VO2max = 132.853 - 0.0769*weight_lb - 0.3877*age - 3.2649*time_min - 0.1565*finish_hr + 6.315*sex",
        "sex": "1 = male, 0 = female",
        "source": "Kline et al. 1987 (Rockport 1-Mile Walk Test)"
      }
