      "rowVo2Concept2": {
        "source": "Concept2 VO2max calculator FAQ ('What is the formula used?'), from Dr. Fritz Hagerman's data comparing lab-measured VO2max with 2000m rowing times.",
        "expression": "Y (L/min) = intercept - slope * time_min, where time_min is the full 2000m time in minutes. VO2max (ml/kg/min) = Y * 1000 / weight_kg.",
        "highlyTrained": {
          "male": {
            "weightSplitKg": 75,
            "atOrBelowSplit": {
