{
  "meta": {
    "source": "Primedy Healthspan Challenge Assessment Scorecard (June 2026 version)",
    "notes": [
      "Every number here was transcribed from the scorecard PDF. Tier ranges were converted to machine-readable thresholds (see tierRules).",
      "Sex keys: 'male' / 'female'. Age-band keys: 'under40' (<40), '40to59', '60plus'.",
      "Median arrays are ordered by decade: 20-29, 30-39, 40-49, 50-59, 60-69, 70+ and are anchored at ages 25, 35, 45, 55, 65, 75."
    ]
  },
  "tierOrder": [
    "elite",
    "strong",
    "good",
    "fair",
    "at_risk"
  ],
  "tierPoints": {
    "elite": 10,
    "strong": 8,
    "good": 6,
    "fair": 4,
    "at_risk": 2,
    "not_tested": 0
  },
  "tierRules": {
    "higher_is_better": "thresholds = minimum value for [elite, strong, good, fair]. Walk the list; the first tier whose minimum the result meets (result >= min) wins. Below the fair minimum = at_risk. A null threshold means that tier cannot be reached on this table.",
    "lower_is_better": "thresholds = exclusive upper limit for [elite, strong, good, fair]. The first tier where result < limit wins. At or above the fair limit = at_risk. Times are in seconds. Run and row cutoffs include their boundary second (e.g. elite 421 = 7:00 or faster), so a time at a cutoff lands in the same tier as its VO2 in vo2maxTiers."
  },
  "healthspanBands": [
    {
      "min": 90,
      "max": 100,
      "key": "elite",
      "label": "Elite Healthspan",
      "description": "Performing in the top tier across the board. Functional age indicator 20-39 regardless of chronological age."
    },
    {
      "min": 70,
      "max": 89,
      "key": "strong",
      "label": "Strong Healthspan",
      "description": "Above average across most components. Functional age indicator 10-15 years younger than chronological."
    },
    {
      "min": 50,
      "max": 69,
      "key": "good",
      "label": "Good Healthspan",
      "description": "Solid baseline with clear targets for improvement. Functional age tracks roughly with chronological age."
    },
    {
      "min": 30,
      "max": 49,
      "key": "fair",
      "label": "Fair Healthspan",
      "description": "Significant room to improve. Multiple components below age/sex norms. Targeted programming recommended."
    },
    {
      "min": 0,
      "max": 29,
      "key": "at_risk",
      "label": "At-Risk Healthspan",
      "description": "Elevated mortality risk based on combined predictors. Immediate intervention is the priority."
    }
  ],
